rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'azizulhakim886@outlook.com' ||
        (request.auth.token.email != null && request.auth.token.email.matches('.*admin.*'))
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSuperAdmin() || (
        isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'staff']
      );
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) || isAdmin() || isSuperAdmin();
    }

    // Products Collection
    match /products/{productId} {
      allow read: if true; // Public catalog
      allow write: if isAuthenticated();
    }

    // Categories Collection
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Banners & Homepage Visuals
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Delivery Zones & Overrides
    match /deliveryZones/{zoneId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Settings (Logistics, Announcement, Categories, Coupons)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Coupons Collection
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Customer Reviews
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAuthenticated();
    }

    // Orders Collection
    match /orders/{orderId} {
      allow read, create, update: if true;
      allow delete: if isAuthenticated();
    }

    // Wishlists Collection
    match /wishlists/{userId} {
      allow read, write: if isOwner(userId) || isAuthenticated();
    }
  }
}
